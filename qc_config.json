  "dark_gray_below": 80.0,
  "dark_od_min": 0.9,
  "dark_fraction_flag_above": 0.15,
  "artifact_flags_are_rejections": false,
  "absence_of_flags_is_artifact_clearance": false,
  "mask_morphology": "none"
